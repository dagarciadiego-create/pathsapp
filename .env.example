# Copy this file to .env and adjust as needed.
# Needs a real Postgres database — there is no local/file-based fallback.
# Easiest option: a Netlify DB (Settings > Extensions > Netlify DB on your
# site) automatically injects NETLIFY_DATABASE_URL(_UNPOOLED), so DATABASE_URL
# below is only required for local development. See README section 3.
DATABASE_URL="postgresql://user:password@localhost:5432/pathsapp"
