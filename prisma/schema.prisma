// PATHSapp data model
// "Enum-like" fields are plain String columns (not native Postgres enums)
// so the allowed values can evolve without a migration; they are enforced
// in the app layer (see src/lib/constants.ts) and validated with zod.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A single advocacy/lobby objective ("labor de advocacy y lobby").
model AdvocacyGoal {
  id          String   @id @default(cuid())
  name        String
  /// "ACTION" (hacer cosas) | "OUTCOME" (conseguir cosas)
  kind        String
  responsible String
  /// Optional thematic tag, e.g. "Acceso a tratamiento", "Financiación"
  category    String?
  description String?
  targetDate  DateTime?
  /// "NOT_STARTED" | "IN_PROGRESS" | "ACHIEVED" | "STALLED" | "CANCELLED"
  status      String   @default("IN_PROGRESS")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goalContacts GoalContact[]
  subtasks     Subtask[]
  indicators   Indicator[]
  commitments  Commitment[]
}

/// A stakeholder in the shared contact directory. Not tied to a single
/// goal — the same person/organization can be relevant to several goals
/// (see GoalContact).
model Contact {
  id           String   @id @default(cuid())
  name         String
  organization String?
  role         String?
  email        String?
  phone        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  goalLinks    GoalContact[]
  /// Interaction log entries involving this contact (see Subtask.contactId).
  interactions Subtask[]
  commitments  Commitment[]
}

/// Links a directory Contact to a goal, with a relation type that is
/// specific to that goal (the same person could be a decision-maker for
/// one goal and merely a supporter for another).
model GoalContact {
  id        String       @id @default(cuid())
  goalId    String
  goal      AdvocacyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// "DECISION_MAKER" (de quien depende conseguirlo) | "SUPPORTER" (quien puede ayudar)
  relation  String
  notes     String?
  /// Current stance on this goal: "CHAMPION" | "FRIENDLY" | "NEUTRAL" |
  /// "SKEPTICAL" | "OPPOSED". History of changes in StanceChange.
  stance    String?
  createdAt DateTime     @default(now())

  stanceHistory StanceChange[]

  @@unique([goalId, contactId])
  @@index([goalId])
  @@index([contactId])
}

/// A dated record of a stance change on a GoalContact, so movement over
/// time can be charted instead of only showing the current value.
model StanceChange {
  id            String      @id @default(cuid())
  goalContactId String
  goalContact   GoalContact @relation(fields: [goalContactId], references: [id], onDelete: Cascade)
  stance        String
  note          String?
  changedAt     DateTime    @default(now())

  @@index([goalContactId])
}

/// A small, concrete action or logged interaction: a letter, call,
/// meeting, encounter... Usually tied to a goal, but goalId is optional so
/// a quick interaction with a contact can be logged before there's a
/// specific goal for it yet (see Contact.interactions).
model Subtask {
  id          String        @id @default(cuid())
  goalId      String?
  goal        AdvocacyGoal? @relation(fields: [goalId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  name        String
  /// "LETTER" | "CALL" | "MEETING" | "ENCOUNTER" | "CAMPAIGN" | "OTHER"
  actionType  String
  /// Planned in advance vs. reactive/unplanned action
  isPlanned   Boolean       @default(true)
  dueDate     DateTime?
  /// "PENDING" | "IN_PROGRESS" | "DONE" | "CANCELLED"
  status      String        @default("PENDING")
  responsible String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  attachments Attachment[]

  @@index([goalId])
  @@index([contactId])
}

/// A file attached to a subtask (the sent letter, meeting minutes, a photo
/// of the encounter...). Stored on local disk outside of `public/`, served
/// through /api/attachments/[id]/file.
model Attachment {
  id         String   @id @default(cuid())
  subtaskId  String
  subtask    Subtask  @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime @default(now())

  @@index([subtaskId])
}

/// A success indicator / KPI, optionally linked to a specific goal.
model Indicator {
  id           String   @id @default(cuid())
  goalId       String?
  goal         AdvocacyGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  name         String
  targetValue  Float
  currentValue Float    @default(0)
  unit         String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([goalId])
}

/// A promise made *to us* by a contact (not an action we took) — e.g. "the
/// DG said she'd raise this at the next Consejo Interterritorial" — with a
/// follow-up date so it can be chased instead of forgotten.
model Commitment {
  id           String        @id @default(cuid())
  contactId    String
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  goalId       String?
  goal         AdvocacyGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  description  String
  madeDate     DateTime
  followUpDate DateTime?
  /// "PENDING" | "FULFILLED" | "BROKEN"
  status       String        @default("PENDING")
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([contactId])
  @@index([goalId])
}
