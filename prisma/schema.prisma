// PATHSapp data model
// "Enum-like" fields are plain String columns (not native Postgres enums)
// so the allowed values can evolve without a migration; they are enforced
// in the app layer (see src/lib/constants.ts) and validated with zod.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A single advocacy/lobby objective ("labor de advocacy y lobby").
model AdvocacyGoal {
  id          String    @id @default(cuid())
  /// Workshop team that owns this record. Every query is scoped by
  /// it so the groups in the room don't see each other's work.
  team        String
  name        String
  /// "ACTION" (hacer cosas) | "OUTCOME" (conseguir cosas)
  kind        String
  responsible String
  /// Optional thematic tag, e.g. "Acceso a tratamiento", "Financiación"
  category    String?
  description String?
  targetDate  DateTime?
  /// "NOT_STARTED" | "IN_PROGRESS" | "ACHIEVED" | "STALLED" | "CANCELLED"
  status      String    @default("IN_PROGRESS")
  /// Effort to achieve it (1=low..5=high) for the effort-impact triage view.
  /// Unset until the user scores it.
  effortScore Int?
  /// Expected impact if achieved (1=low..5=high), same scale as effortScore.
  impactScore Int?
  /// Set when status last transitioned into ACHIEVED (cleared if reopened),
  /// so the outcome-chain narrative has a real date instead of reusing
  /// updatedAt, which changes on any unrelated edit.
  achievedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  goalContacts  GoalContact[]
  subtasks      Subtask[]
  indicators    Indicator[]
  commitments   Commitment[]
  deadlines     Deadline[]
  jointLetters  JointLetter[]
  mediaCoverage MediaCoverage[]

  @@index([team])
}

/// A stakeholder in the shared contact directory. Not tied to a single
/// goal — the same person/organization can be relevant to several goals
/// (see GoalContact).
model Contact {
  id           String   @id @default(cuid())
  /// Workshop team that owns this record. Every query is scoped by
  /// it so the groups in the room don't see each other's work.
  team         String
  name         String
  organization String?
  role         String?
  email        String?
  phone        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  goalLinks           GoalContact[]
  /// Interaction log entries involving this contact (see Subtask.contactId).
  interactions        Subtask[]
  commitments         Commitment[]
  connectionsAsA      ContactConnection[] @relation("ConnectionA")
  connectionsAsB      ContactConnection[] @relation("ConnectionB")
  positionHolderships PositionHolder[]

  @@index([team])
}

/// An office/seat whose occupant changes over time (a ministry
/// directorate, a parliamentary seat...) — tracked separately from the
/// person currently holding it, so the advocacy relationship with
/// "whoever holds this role" survives an election or a reshuffle.
model Position {
  id           String   @id @default(cuid())
  /// Workshop team that owns this record. Every query is scoped by
  /// it so the groups in the room don't see each other's work.
  team         String
  title        String
  organization String?
  notes        String?
  createdAt    DateTime @default(now())

  holders PositionHolder[]

  @@index([team])
}

/// One person's tenure in a Position. The current holder is the one with
/// endDate null; assigning a new holder closes out the previous one's
/// endDate (enforced in the API route, not by a DB constraint).
model PositionHolder {
  id         String    @id @default(cuid())
  positionId String
  position   Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([positionId])
  @@index([contactId])
}

/// A date on the broader political/legislative calendar (budget
/// presentations, elections, awareness days) shown as a distinct overlay
/// on the calendar, even though it isn't an action this organization
/// takes itself.
model StrategicDate {
  id          String   @id @default(cuid())
  /// Workshop team that owns this record. Every query is scoped by
  /// it so the groups in the room don't see each other's work.
  team        String
  title       String
  /// "BUDGET" | "ELECTION" | "AWARENESS_DAY" | "LEGISLATIVE" | "OTHER"
  kind        String
  date        DateTime
  description String?
  /// Recurs on the same month/day every year (awareness days, a typical
  /// budget presentation window) vs. a specific one-off date (a
  /// particular election).
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([team])
}

/// A designated spokesperson authorized to represent the organization
/// publicly — distinct from Contact, which tracks external stakeholders
/// rather than the organization's own people.
model Spokesperson {
  id           String   @id @default(cuid())
  /// Workshop team that owns this record. Every query is scoped by
  /// it so the groups in the room don't see each other's work.
  team         String
  name         String
  role         String?
  /// Topics/areas this person is prepared to speak on (free text, kept
  /// simple rather than introducing a separate tagging model).
  topics       String?
  email        String?
  phone        String?
  bio          String?
  /// Whether they've completed media training / are cleared to speak to
  /// press without additional prep.
  mediaTrained Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([team])
}

/// An informal link between two contacts — "who can open a door to X" —
/// e.g. a board member's relative works in an official's office. Undirected
/// in practice: shown on both contacts' pages regardless of which side
/// created it.
model ContactConnection {
  id          String   @id @default(cuid())
  contactAId  String
  contactA    Contact  @relation("ConnectionA", fields: [contactAId], references: [id], onDelete: Cascade)
  contactBId  String
  contactB    Contact  @relation("ConnectionB", fields: [contactBId], references: [id], onDelete: Cascade)
  description String
  createdAt   DateTime @default(now())

  @@index([contactAId])
  @@index([contactBId])
}

/// Links a directory Contact to a goal, with a relation type that is
/// specific to that goal (the same person could be a decision-maker for
/// one goal and merely a supporter for another).
model GoalContact {
  id        String       @id @default(cuid())
  goalId    String
  goal      AdvocacyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// "DECISION_MAKER" (de quien depende conseguirlo) | "SUPPORTER" (quien puede ayudar)
  relation  String
  notes     String?
  /// Current stance on this goal: "CHAMPION" | "FRIENDLY" | "NEUTRAL" |
  /// "SKEPTICAL" | "OPPOSED". History of changes in StanceChange.
  stance    String?
  createdAt DateTime     @default(now())

  stanceHistory StanceChange[]

  @@unique([goalId, contactId])
  @@index([goalId])
  @@index([contactId])
}

/// A dated record of a stance change on a GoalContact, so movement over
/// time can be charted instead of only showing the current value.
model StanceChange {
  id            String      @id @default(cuid())
  goalContactId String
  goalContact   GoalContact @relation(fields: [goalContactId], references: [id], onDelete: Cascade)
  stance        String
  note          String?
  changedAt     DateTime    @default(now())

  @@index([goalContactId])
}

/// A small, concrete action or logged interaction: a letter, call,
/// meeting, encounter... Usually tied to a goal, but goalId is optional so
/// a quick interaction with a contact can be logged before there's a
/// specific goal for it yet (see Contact.interactions).
model Subtask {
  id          String        @id @default(cuid())
  goalId      String?
  goal        AdvocacyGoal? @relation(fields: [goalId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  name        String
  /// "LETTER" | "CALL" | "MEETING" | "ENCOUNTER" | "CAMPAIGN" | "OTHER"
  actionType  String
  /// Planned in advance vs. reactive/unplanned action
  isPlanned   Boolean       @default(true)
  dueDate     DateTime?
  /// "PENDING" | "IN_PROGRESS" | "DONE" | "CANCELLED"
  status      String        @default("PENDING")
  responsible String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  attachments Attachment[]

  @@index([goalId])
  @@index([contactId])
}

/// A file attached to a subtask (the sent letter, meeting minutes, a photo
/// of the encounter...). Stored on local disk outside of `public/`, served
/// through /api/attachments/[id]/file.
model Attachment {
  id         String   @id @default(cuid())
  subtaskId  String
  subtask    Subtask  @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime @default(now())

  @@index([subtaskId])
}

/// A success indicator / KPI, optionally linked to a specific goal.
model Indicator {
  id           String        @id @default(cuid())
  /// Workshop team that owns this record. Every query is scoped by
  /// it so the groups in the room don't see each other's work.
  team         String
  goalId       String?
  goal         AdvocacyGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  name         String
  targetValue  Float
  currentValue Float         @default(0)
  unit         String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([goalId])
  @@index([team])
}

/// A promise made *to us* by a contact (not an action we took) — e.g. "the
/// DG said she'd raise this at the next Consejo Interterritorial" — with a
/// follow-up date so it can be chased instead of forgotten.
model Commitment {
  id           String        @id @default(cuid())
  contactId    String
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  goalId       String?
  goal         AdvocacyGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  description  String
  madeDate     DateTime
  followUpDate DateTime?
  /// "PENDING" | "FULFILLED" | "BROKEN"
  status       String        @default("PENDING")
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([contactId])
  @@index([goalId])
}

/// An external window with a hard deadline — a public consultation, a
/// parliamentary hearing slot, an amendment deadline — tracked so it's
/// never missed. Distinct from Subtask: this isn't our own action, it's a
/// window the outside world opened that we need to act within.
model Deadline {
  id          String        @id @default(cuid())
  /// Workshop team that owns this record. Every query is scoped by
  /// it so the groups in the room don't see each other's work.
  team        String
  title       String
  /// "PUBLIC_CONSULTATION" | "HEARING" | "AMENDMENT" | "OTHER"
  kind        String
  description String?
  dueDate     DateTime
  responsible String?
  /// "OPEN" | "SUBMITTED" | "MISSED" | "CANCELLED"
  status      String        @default("OPEN")
  goalId      String?
  goal        AdvocacyGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([goalId])
  @@index([team])
}

/// A reusable formal ask/petition (a policy demand, a position statement)
/// that can be cited across multiple goals over time, versioned so
/// changes to the wording stay visible instead of being overwritten.
model Petition {
  id        String   @id @default(cuid())
  /// Workshop team that owns this record. Every query is scoped by
  /// it so the groups in the room don't see each other's work.
  team      String
  title     String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions PetitionVersion[]
  evidence Evidence[]

  @@index([team])
}

/// One version of a petition's text, in Spanish and (optionally) English
/// so the same formal ask can be sent to national and EU-level bodies.
model PetitionVersion {
  id         String   @id @default(cuid())
  petitionId String
  petition   Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  contentEs  String
  contentEn  String?
  notes      String?
  createdAt  DateTime @default(now())

  @@index([petitionId])
}

/// A piece of supporting evidence (a study, a statistic, a reference to
/// testimonials) backing a petition.
model Evidence {
  id         String    @id @default(cuid())
  // Evidence carries its own team rather than inheriting one from the
  // petition: petitionId is nullable, so a deleted petition would
  // otherwise leave orphan rows belonging to nobody.
  team       String
  petitionId String?
  petition   Petition? @relation(fields: [petitionId], references: [id], onDelete: SetNull)
  title      String
  source     String?
  url        String?
  summary    String?
  createdAt  DateTime  @default(now())

  @@index([petitionId])
  @@index([team])
}

/// A joint sign-on letter — an advocacy letter several organizations
/// co-sign together. Tracked separately from Subtask because what
/// matters here is who co-signed, not a single action this organization
/// took alone.
model JointLetter {
  id         String        @id @default(cuid())
  /// Workshop team that owns this record. Every query is scoped by
  /// it so the groups in the room don't see each other's work.
  team       String
  title      String
  targetName String?
  sentDate   DateTime?
  content    String?
  url        String?
  goalId     String?
  goal       AdvocacyGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  cosigners JointLetterCosigner[]

  @@index([goalId])
  @@index([team])
}

/// One organization's co-signing status on a joint letter.
model JointLetterCosigner {
  id            String      @id @default(cuid())
  jointLetterId String
  jointLetter   JointLetter @relation(fields: [jointLetterId], references: [id], onDelete: Cascade)
  organization  String
  contactName   String?
  /// "INVITED" | "CONFIRMED" | "DECLINED" | "SIGNED"
  status        String      @default("INVITED")
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([jointLetterId])
}

/// A press mention or media appearance, logged so the organization can
/// show its media footprint and track how coverage of a goal evolves.
model MediaCoverage {
  id            String        @id @default(cuid())
  /// Workshop team that owns this record. Every query is scoped by
  /// it so the groups in the room don't see each other's work.
  team          String
  outlet        String
  title         String
  url           String?
  publishedDate DateTime
  /// "POSITIVE" | "NEUTRAL" | "NEGATIVE"
  tone          String        @default("NEUTRAL")
  reach         Int?
  goalId        String?
  goal          AdvocacyGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([goalId])
  @@index([team])
}
